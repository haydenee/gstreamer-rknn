# Docker开发环境环境变量配置模板
# 复制此文件为 .env 并根据需要修改

# 用户配置（匹配宿主机用户）
USER_ID=1000
GROUP_ID=1000
USER_NAME=developer

# 显示配置（用于GUI应用）
DISPLAY=:0

# 时区设置
TZ=Asia/Shanghai

# 容器配置
CONTAINER_NAME=gstreamer-rknn-dev
IMAGE_NAME=gstreamer-rknn:dev

# 资源限制
MEMORY_LIMIT=8G
MEMORY_RESERVATION=4G

# 卷挂载路径（可自定义）
WORKSPACE_PATH=..
CACHE_PATH=./cache
HISTORY_PATH=./history